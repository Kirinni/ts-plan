#!/bin/sh /etc/rc.common
# 内存运行 Tailscale：
#   开机检查 /tmp（tmpfs）里有没有二进制 -> 没有就后台拉取 -> 起来后接入 headscale
#
# 手工操作：
#   /etc/init.d/tailscale-ram enable|disable|start|stop|restart

START=99
STOP=05
USE_PROCD=1

. /etc/tailscale/ts.conf

TS_DAEMON="$TS_DIR/tailscaled"
TS_CLI="$TS_DIR/tailscale"

# 等服务起来后执行 tailscale up（幂等，可反复调用）
ts_up() {
	if [ ! -x "$TS_CLI" ]; then
		# 日常不需要 CLI：state 里有 prefs，daemon 启动会自行恢复连接
		if [ -f "$STATE_DIR/tailscaled.state" ]; then
			logger -t tailscale-ram "无 CLI（内存已释放），state 存在，daemon 自行恢复连接"
			return 0
		fi
		logger -t tailscale-ram "无 CLI 且无 state：尚未注册，请执行 ts-login"
		return 1
	fi

	i=0
	while [ "$i" -lt 90 ]; do
		[ -S "$SOCKET" ] && break
		sleep 2
		i=$((i + 1))
	done
	if [ ! -S "$SOCKET" ]; then
		logger -t tailscale-ram "socket 未就绪，放弃 tailscale up"
		return 1
	fi

	args="--login-server=$LOGIN_SERVER --hostname=$HOSTNAME_OVERRIDE"
	[ -n "$ADVERTISE_ROUTES" ] && args="$args --advertise-routes=$ADVERTISE_ROUTES"
	for extra in $UP_EXTRA; do
		args="$args $extra"
	done

	logger -t tailscale-ram "tailscale up $args"
	if [ -s "$AUTHKEY_FILE" ]; then
		# shellcheck disable=SC2086
		"$TS_CLI" --socket="$SOCKET" up $args --authkey="$(cat "$AUTHKEY_FILE")"
	else
		# shellcheck disable=SC2086
		"$TS_CLI" --socket="$SOCKET" up $args
	fi
	rc=$?
	if [ "$rc" = "0" ]; then
		logger -t tailscale-ram "tailscale up 成功"
	else
		logger -t tailscale-ram "tailscale up 失败 rc=$rc（详见 /tmp/ts-up.log）"
	fi
	return $rc
}

start_service() {
	mkdir -p "$TS_DIR" "$STATE_DIR"
	chmod 0700 "$STATE_DIR" 2>/dev/null

	# 已经在跑：只确保 up 参数生效
	if pidof tailscaled >/dev/null 2>&1; then
		logger -t tailscale-ram "tailscaled 已在运行，仅确保 up"
		( ts_up ) >>/tmp/ts-up.log 2>&1 &
		return 0
	fi

	# tmpfs 里没有二进制 -> 后台拉取，成功后重入 start（不阻塞开机）
	if [ ! -x "$TS_DAEMON" ]; then
		if [ -e /tmp/.ts-fetch-running ]; then
			logger -t tailscale-ram "拉取已在进行中"
			return 0
		fi
		touch /tmp/.ts-fetch-running
		logger -t tailscale-ram "tmpfs 中无二进制，开始后台拉取"
		(
			/usr/sbin/ts-fetch
			rc=$?
			rm -f /tmp/.ts-fetch-running
			if [ "$rc" != "0" ]; then
				logger -t tailscale-ram "拉取失败，10 分钟后再试一次"
				sleep 600
			fi
			if [ -x /tmp/tailscale/tailscaled ]; then
				/etc/init.d/tailscale-ram restart
			fi
		) >>/tmp/ts-fetch.log 2>&1 &
		return 0
	fi

	procd_open_instance tailscale-ram
	procd_set_param command "$TS_DAEMON" \
		--state="$STATE_DIR/tailscaled.state" \
		--socket="$SOCKET" \
		--port=41641
	# 可选：--no-logs-no-support   不向 Tailscale 上报日志、不上传支持包
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	( ts_up ) >>/tmp/ts-up.log 2>&1 &
}

stop_service() {
	rm -f /tmp/.ts-fetch-running
	if [ -S "$SOCKET" ] && [ -x "$TS_CLI" ]; then
		"$TS_CLI" --socket="$SOCKET" down >/dev/null 2>&1
	fi
	return 0
}
