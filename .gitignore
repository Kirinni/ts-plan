# ---------------------------------------------------------------------------
# 这个仓库只放"模板"：真实域名、分发 token、凭据一律留在设备上，不进版本库。
# ---------------------------------------------------------------------------

# 填了真实值的配置（真实 headscale 域名 / 分发 token / 真实 sha256）
ts.conf.local

# 凭据：preauth key 只写在路由器上
authkey
*.authkey

# 构建产物：单二进制 30.5MB、tar.gz 9.9MB，进仓库只会把体积撑爆
# dist/ 是 CI（.github/workflows/build.yml）和 make-*-sh 的默认输出目录
out/
dist/
tailscaled_*_mipsle*
*.tar.gz
*.sha256

# 本地验证用的临时脚本与日志
.run*.sh
.boot*.sh
.build*.sh
.cli*.sh
.selftest*
*.log
# 临时提交信息文件（git commit -F 用，省得被 PowerShell 的引号处理搞坏）
.commitmsg*

# 编辑器 / 系统垃圾
.DS_Store
Thumbs.db
*.swp
